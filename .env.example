# --- AI (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash          # generation, grading
GEMINI_CHECK_MODEL=gemini-3.8-flash    # fact-check (can be a stronger model)
# GEMINI_THINKING_LEVEL=low            # optional: minimal|low|medium|high

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                   # pick a voice that sounds good in Czech
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Storage (added automatically when a Vercel Blob store is connected) ---
BLOB_READ_WRITE_TOKEN=

# --- Optional ---
ACCESS_CODE=                           # if set, the app asks for this code once per device
# MOCK_AI=1                            # local testing without API keys
